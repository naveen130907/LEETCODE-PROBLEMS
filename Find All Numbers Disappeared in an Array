class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        HashSet<Integer>a=new HashSet<>();
        for(int b:nums){
            a.add(b);
        }
        ArrayList<Integer>b=new ArrayList<>();
        for(int i=0;i<nums.length;i++){
            if(!a.contains(i+1)){
                b.add(i+1);
            }
        }
        return b;
    }
}
